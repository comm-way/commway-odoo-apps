<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_website_revocation_tree" model="ir.ui.view">
        <field name="name">website.revocation.tree</field>
        <field name="model">website.revocation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="customer_name"/>
                <field name="customer_email"/>
                <field name="sale_order_id"/>
                <field name="revocation_date"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'process'" 
                       decoration-success="state == 'approved'" 
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_website_revocation_form" model="ir.ui.view">
        <field name="name">website.revocation.form</field>
        <field name="model">website.revocation</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_in_process" type="object" string="Set to In Review" invisible="state != 'draft'"/>
                    <button name="action_approve_and_refund" type="object" string="Accept &amp; Refund" class="oe_highlight" invisible="state in ['approved', 'rejected']"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state in ['approved', 'rejected']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,process,approved,rejected"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="sale_order_id or not order_reference">
                        The order number entered by the customer could not be found. Please identify the order manually.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Customer Data">
                            <field name="customer_name"/>
                            <field name="customer_email"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="Details &amp; Reference">
                            <field name="revocation_date"/>
                            <field name="sale_order_id"/>
                            <field name="order_reference" invisible="not order_reference"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items to Withdraw" name="revocation_items">
                            <field name="revocation_items" placeholder="Entire order (no individual items specified)"/>
                        </page>
                        <page string="Customer's Reason">
                            <field name="reason" placeholder="No reason provided..."/>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_website_revocation" model="ir.actions.act_window">
        <field name="name">Revocations</field>
        <field name="res_model">website.revocation</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_website_revocation" 
              name="Revocations" 
              action="action_website_revocation" 
              parent="sale.sale_order_menu" 
              sequence="50"/>
</odoo>