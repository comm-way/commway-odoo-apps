#. module: website_sale_revocation
#. odoo-python
#: code:addons/website_sale_revocation/controllers/main.py:0
msgid "<b>ATTENTION:</b> A revocation request (%s) has been submitted."
msgstr "<b>ACHTUNG:</b> Ein Widerrufsantrag (%s) wurde eingereicht."

#. module: website_sale_revocation
#: model:mail.template,body_html:website_sale_revocation.email_template_revocation_receipt
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Hello <t t-out=\"object.customer_name or 'Customer'\"/>,<br/><br/>\n"
"                        We hereby confirm the receipt of your revocation request.<br/>\n"
"                        Your reference number is: <strong><t t-out=\"object.name\"/></strong><br/><br/>\n"
"                        We will review your request as quickly as possible and get back to you shortly.<br/><br/>\n"
"                        Best regards,<br/>\n"
"                        Your Customer Service Team\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Guten Tag <t t-out=\"object.customer_name or 'Kunde'\"/>,<br/><br/>\n"
"        wir bestätigen hiermit den Eingang Ihres Widerrufs.<br/>\n"
"        Ihre Referenznummer lautet: <strong><t t-out=\"object.name\"/></strong><br/><br/>\n"
"        Wir werden Ihr Anliegen schnellstmöglich prüfen und uns in Kürze bei Ihnen melden.<br/><br/>\n"
"        Mit freundlichen Grüßen<br/>\n"
"        Ihr Kundenservice-Team\n"
"    </p>\n"
"</div>"

#. module: website_sale_revocation
#. odoo-python
#: code:addons/website_sale_revocation/models/website_revocation.py:0
msgid ""
"<p>Hello %s,</p><p>we have reviewed and accepted your revocation. The refund"
" will be processed shortly.</p>"
msgstr ""
"<p>Guten Tag %s,</p><p>wir haben Ihren Widerruf geprüft und akzeptiert. Die "
"Erstattung wird in Kürze veranlasst.</p>"

#. module: website_sale_revocation
#. odoo-python
#: code:addons/website_sale_revocation/models/website_revocation.py:0
msgid ""
"<p>Hello %s,</p><p>we have reviewed your revocation. Unfortunately, we "
"cannot accept it.</p>"
msgstr ""
"<p>Guten Tag %s,</p><p>wir haben Ihren Widerruf geprüft. Leider können wir "
"diesen nicht akzeptieren.</p>"

