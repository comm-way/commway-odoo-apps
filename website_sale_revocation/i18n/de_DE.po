#. module: website_sale_revocation
#. odoo-python
#: code:addons/website_sale_revocation/controllers/main.py:0
msgid "<b>ATTENTION:</b> A revocation request (%s) has been submitted."
msgstr "<b>ACHTUNG:</b> Ein Widerrufsantrag (%s) wurde eingereicht."

#. module: website_sale_revocation
#: model:mail.template,body_html:website_sale_revocation.email_template_revocation_accepted
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-family: 'Segoe UI', Arial, sans-serif;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px; color: #243746;\">\n"
"                    Hello <t t-out=\"object.customer_name or 'Customer'\"/>,<br/><br/>\n"
"                    We have reviewed and accepted your revocation request for reference <strong><t t-out=\"object.name\"/></strong>.<br/>\n"
"                    The refund process has been initiated and will be completed shortly.<br/><br/>                    \n"
"                </p>\n"
"                \n"
"                <t t-if=\"user.signature\">\n"
"                    <br/>\n"
"                    <div style=\"font-size: 13px; color: #243746;\">\n"
"                        <t t-out=\"user.signature or ''\"/>\n"
"                    </div>\n"
"                </t>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-family: 'Segoe UI', Arial, sans-serif;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px; color: #243746;\">\n"
"                    Guten Tag <t t-out=\"object.customer_name or 'Kunde'\"/>,<br/><br/>\n"
"                    wir haben Ihren Widerruf mit der Referenznummer <strong><t t-out=\"object.name\"/></strong> geprüft und akzeptiert.<br/>\n"
"                    Die Erstattung wurde in die Wege geleitet und wird in Kürze abgeschlossen.<br/><br/>\n"
"                </p>\n"
"                \n"
"                <t t-if=\"user.signature\">\n"
"                    <br/>\n"
"                    <div style=\"font-size: 13px; color: #243746;\">\n"
"                        <t t-out=\"user.signature or ''\"/>\n"
"                    </div>\n"
"                </t>\n"
"            </div>\n"
"        "

#. module: website_sale_revocation
#: model:mail.template,body_html:website_sale_revocation.email_template_revocation_rejected
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-family: 'Segoe UI', Arial, sans-serif;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px; color: #243746;\">\n"
"                    Hello <t t-out=\"object.customer_name or 'Customer'\"/>,<br/><br/>\n"
"                    We have reviewed your revocation request for reference <strong><t t-out=\"object.name\"/></strong>.<br/>\n"
"                    Unfortunately, after careful review, we cannot accept your request at this time.<br/><br/>                    \n"
"                </p>\n"
"                \n"
"                <t t-if=\"user.signature\">\n"
"                    <br/>\n"
"                    <div style=\"font-size: 13px; color: #243746;\">\n"
"                        <t t-out=\"user.signature or ''\"/>\n"
"                    </div>\n"
"                </t>                \n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-family: 'Segoe UI', Arial, sans-serif;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px; color: #243746;\">\n"
"                    Guten Tag <t t-out=\"object.customer_name or 'Kunde'\"/>,<br/><br/>\n"
"                    wir haben Ihren Widerruf mit der Referenznummer <strong><t t-out=\"object.name\"/></strong> geprüft.<br/>\n"
"                    Leider können wir Ihrem Antrag nach sorgfältiger Prüfung nicht stattgeben. Unser Kundenservice wird sich bezüglich der Details in Kürze bei Ihnen melden.<br/><br/>\n"
"                </p>\n"
"                \n"
"                <t t-if=\"user.signature\">\n"
"                    <br/>\n"
"                    <div style=\"font-size: 13px; color: #243746;\">\n"
"                        <t t-out=\"user.signature or ''\"/>\n"
"                    </div>\n"
"                </t>\n"
"            </div>\n"
"        "

#. module: website_sale_revocation
#: model:mail.template,body_html:website_sale_revocation.email_template_revocation_receipt
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Hello <t t-out=\"object.customer_name or 'Customer'\"/>,<br/><br/>\n"
"                        We hereby confirm the receipt of your revocation request.<br/>\n"
"                        Your reference number is: <strong><t t-out=\"object.name\"/></strong><br/><br/>\n"
"                        We will review your request as quickly as possible and get back to you shortly.<br/><br/>\n"
"                    </p>\n"
"                    \n"
"                    <t t-set=\"assigned_user\" t-value=\"object.env.company.revocation_notification_user_id or object.env.ref('base.user_admin')\"/>\n"
"                    <t t-if=\"assigned_user and assigned_user.signature\">\n"
"                    <br/>\n"
"                    <div style=\"font-size: 13px; color: #243746;\">\n"
"                        <t t-out=\"assigned_user.signature\"/>\n"
"                    </div>\n"
"                    </t>\n"
"                </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-family: 'Segoe UI', Arial, sans-serif;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px; color: #243746;\">\n"
"        Guten Tag <t t-out=\"object.customer_name or 'Kunde'\"/>,<br/><br/>\n"
"        wir bestätigen hiermit den Eingang Ihres Widerrufs.<br/>\n"
"        Ihre Referenznummer lautet: <strong><t t-out=\"object.name\"/></strong><br/><br/>\n"
"        Wir werden Ihr Anliegen schnellstmöglich prüfen und uns in Kürze bei Ihnen melden.<br/><br/>\n"
"    </p>\n"
"    \n"
"    <t t-set=\"assigned_user\" t-value=\"object.env.company.revocation_notification_user_id or object.env.ref('base.user_admin')\"/>\n"
"    <t t-if=\"assigned_user and assigned_user.signature\">\n"
"    <br/>\n"
"    <div style=\"font-size: 13px; color: #243746;\">\n"
"       <t t-out=\"assigned_user.signature\"/>\n"
"    </div>\n"
"    </t>\n"
"</div>\n"
"        "

